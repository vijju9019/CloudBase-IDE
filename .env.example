# CloudBase IDE Configuration

# Backend Service
PORT=3000
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173

# Storage Guardian
# By default on Windows: %LOCALAPPDATA%\CloudBaseIDE
# Uncomment to override with custom dedicated path
# CLOUDBASE_STORAGE_ROOT=C:\CloudBaseStorage

# Offline AI Engine (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
DEFAULT_AI_MODEL=qwen2.5-coder:1.5b

# Docker Engine Connection
# Windows Named Pipe: //./pipe/dockerDesktopLinuxEngine
# Or TCP: tcp://127.0.0.1:2375
DOCKER_SOCKET=//./pipe/dockerDesktopLinuxEngine
